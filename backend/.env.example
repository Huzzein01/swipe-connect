# Server Configuration
PORT=3001

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/swipeconnect

# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/linkedin/callback

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h

# Session Configuration
SESSION_SECRET=your_session_secret_key

# Frontend URL (used for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Job Scraping Configuration
SCRAPING_INTERVAL=21600000

# Email (Resend) — application confirmation emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=SwipeConnect <noreply@swipeconnect.com>

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Powers AI match scoring, resume tailoring, and cover letter generation.
# Set ANY ONE of these. Tried in this order: Gemini → DeepSeek → Anthropic.
# Gemini & DeepSeek both have free tiers.
#   Gemini:   https://aistudio.google.com/app/apikey
#   DeepSeek: https://platform.deepseek.com/api_keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_MODEL=claude-haiku-4-5
